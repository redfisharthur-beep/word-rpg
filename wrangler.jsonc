{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "word-rpg",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/match"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCHMAKER",
        "class_name": "Matchmaker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Matchmaker"]
    }
  ]
}
